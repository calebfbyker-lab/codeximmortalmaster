src/hooks/useAgentStore.ts
import { useMemo, useReducer, useState } from 'react';
import { mockAgents } from '../data/mockAgents';
import { Agent, AgentStatus } from '../types';

type Draft = {
  name: string;
  role: string;
  authority: Agent['authority'];
};

type Action =
  | { type: 'add'; payload: Agent }
  | { type: 'update'; payload: Agent }
  | { type: 'terminate'; payload: { id: string } };

function reducer(state: Agent[], action: Action): Agent[] {
  switch (action.type) {
    case 'add':
      return [action.payload, ...state];
    case 'update':
      return state.map((agent) => (agent.id === action.payload.id ? action.payload : agent));
    case 'terminate':
      return state.map((agent) =>
        agent.id === action.payload.id
          ? { ...agent, status: 'terminated', lastSeen: nowStamp() }
          : agent
      );
    default:
      return state;
  }
}

function nowStamp() {
  return new Date().toLocaleString('en-US', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
}

function makeId() {
  return `agent-${Math.random().toString(36).slice(2, 8)}`;
}

export function useAgentStore() {
  const [agents, dispatch] = useReducer(reducer, mockAgents);
  const [draft, setDraft] = useState<Draft>({
    name: '',
    role: '',
    authority: 'A1',
  });
  const [editingId, setEditingId] = useState<string | null>(null);

  const activeCount = useMemo(
    () => agents.filter((agent) => agent.status === 'active').length,
    [agents]
  );
  const terminatedCount = useMemo(
    () => agents.filter((agent) => agent.status === 'terminated').length,
    [agents]
  );

  function createAgent() {
    if (!draft.name.trim() || !draft.role.trim()) return;
    const next: Agent = {
      id: makeId(),
      name: draft.name.trim(),
      role: draft.role.trim(),
      authority: draft.authority,
      status: 'active',
      lastSeen: nowStamp(),
    };
    dispatch({ type: 'add', payload: next });
    setDraft({ name: '', role: '', authority: 'A1' });
  }

  function beginEdit(agent: Agent) {
    setEditingId(agent.id);
    setDraft({
      name: agent.name,
      role: agent.role,
      authority: agent.authority,
    });
  }

  function cancelEdit() {
    setEditingId(null);
    setDraft({ name: '', role: '', authority: 'A1' });
  }

  function saveEdit(status: AgentStatus = 'active') {
    if (!editingId || !draft.name.trim() || !draft.role.trim()) return;
    const current = agents.find((agent) => agent.id === editingId);
    if (!current) return;
    dispatch({
      type: 'update',
      payload: {
        ...current,
        name: draft.name.trim(),
        role: draft.role.trim(),
        authority: draft.authority,
        status,
        lastSeen: nowStamp(),
      },
    });
    cancelEdit();
  }

  function terminateAgent(id: string) {
    dispatch({ type: 'terminate', payload: { id } });
    if (editingId === id) cancelEdit();
  }

  return {
    agents,
    draft,
    setDraft,
    editingId,
    activeCount,
    terminatedCount,
    createAgent,
    beginEdit,
    cancelEdit,
    saveEdit,
    terminateAgent,
  };
}

