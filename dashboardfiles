import { DashboardLayout } from './components/DashboardLayout';
import { Sidebar } from './components/Sidebar';
import { AgentLifecyclePanel } from './components/AgentLifecyclePanel';
import { TaskLogPanel } from './components/TaskLogPanel';
import { useAgentStore } from './hooks/useAgentStore';
import { useSimulatedTaskStream } from './hooks/useSimulatedTaskStream';

export default function App() {
  const agentStore = useAgentStore();
  const logStream = useSimulatedTaskStream(agentStore.agents);

  return (
    <DashboardLayout
      sidebar={
        <Sidebar
          activeCount={agentStore.activeCount}
          terminatedCount={agentStore.terminatedCount}
          totalLogs={logStream.logs.length}
        />
      }
      topbar={
        <div className="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p className="text-xs uppercase tracking-[0.24em] text-codex-400">CodexImmortal ecosystem</p>
            <h1 className="mt-2 text-3xl font-semibold text-white">Agent Command Dashboard</h1>
            <p className="mt-2 max-w-3xl text-sm text-slate-400">
              A cohesive React and Tailwind CSS demo for agent lifecycle control and real-time task orchestration visibility.
            </p>
          </div>
          <div className="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <StatCard label="Total Agents" value={String(agentStore.agents.length)} />
            <StatCard label="Active" value={String(agentStore.activeCount)} />
            <StatCard label="Terminated" value={String(agentStore.terminatedCount)} />
            <StatCard label="Live Logs" value={String(logStream.logs.length)} />
          </div>
        </div>
      }
      main={
        <div className="grid gap-6 xl:grid-cols-[1.05fr_0.95fr]">
          <AgentLifecyclePanel store={agentStore} />
          <TaskLogPanel
            logs={logStream.logs}
            isConnected={logStream.isConnected}
            isPaused={logStream.isPaused}
            onTogglePause={logStream.togglePause}
            onClear={logStream.clearLogs}
          />
