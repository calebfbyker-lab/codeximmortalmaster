import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
import { taskDetails, taskNames } from '../data/mockTasks';
import { Agent, TaskLog } from '../types';

const levels: TaskLog['level'][] = ['info', 'success', 'warning', 'error'];

function sample<T>(items: T[]): T {
  return items[Math.floor(Math.random() * items.length)];
}

function makeLog(agents: Agent[]): TaskLog {
  const eligible = agents.filter((agent) => agent.status !== 'terminated');
  const fallback = agents[0];
  const agent = eligible[Math.floor(Math.random() * Math.max(1, eligible.length))] || fallback;
  const now = new Date();
  return {
    id: crypto.randomUUID(),
    timestamp: now.toLocaleTimeString('en-US', { hour12: false }),
    agentId: agent.id,
    agentName: agent.name,
    level: sample(levels),
    task: sample(taskNames),
    detail: sample(taskDetails),
  };
}

export function useSimulatedTaskStream(agents: Agent[]) {
  const [logs, setLogs] = useState<TaskLog[]>(() => [
    {
      id: crypto.randomUUID(),
      timestamp: new Date().toLocaleTimeString('en-US', { hour12: false }),
      agentId: 'boot',
      agentName: 'MN-NET Control Plane',
      level: 'success',
      task: 'Initialize dashboard stream',
      detail: 'Simulated WebSocket channel opened for orchestration logs.',
    },
  ]);
  const [isPaused, setPaused] = useState(false);
  const [isConnected, setConnected] = useState(true);
  const tickRef = useRef<number | null>(null);
  const heartbeatRef = useRef<number | null>(null);

  const appendLog = useCallback(() => {
    setLogs((current) => [makeLog(agents), ...current].slice(0, 120));
  }, [agents]);

  useEffect(() => {
    if (isPaused) return;
    tickRef.current = window.setInterval(() => {
      appendLog();
    }, 1700);
    return () => {
      if (tickRef.current) window.clearInterval(tickRef.current);
    };
  }, [appendLog, isPaused]);

  useEffect(() => {
    heartbeatRef.current = window.setInterval(() => {
      setConnected((current) => current);
    }, 4000);
    return () => {
      if (heartbeatRef.current) window.clearInterval(heartbeatRef.current);
    };
  }, []);

  const togglePause = useCallback(() => {
    setPaused((current) => !current);
  }, []);

  const clearLogs = useCallback(() => {
    setLogs([]);
  }, []);

  const streamHealth = useMemo(() => (isConnected ? 'connected' : 'reconnecting'), [isConnected]);

  return {
    logs,
    isPaused,
    isConnected,
    streamHealth,
    togglePause,
    clearLogs,
  };
}

