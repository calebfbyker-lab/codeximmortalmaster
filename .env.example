# CodexImmortal environment template
# Copy to .env and fill in values. Never commit a populated .env.
# Production secrets are injected at runtime via HashiCorp Vault.

ENVIRONMENT=dev
LOG_LEVEL=DEBUG

# Post-quantum algorithm tiers (production uses ML-DSA-87 / ML-KEM-1024)
PQC_SIGNATURE_ALGORITHM=ML-DSA-65
PQC_KEM_ALGORITHM=ML-KEM-768

# Local inference (Ollama)
MODEL_NAME=llama3.2
INFERENCE_ENDPOINT=http://localhost:11434

# Agent memory graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# HashiCorp Vault
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=

# NFT vault (Base L2)
NFT_CONTRACT_ADDRESS=
