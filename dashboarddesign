## 3. PostgreSQL RLS schema for multi-tenancy

This schema matches common RLS patterns where tenant isolation is enforced by a policy using `current_setting('app.current_tenant')` [2][3][4].

```sql
-- Tenants
CREATE TABLE tenant (
  id   INTEGER PRIMARY KEY,
  name TEXT NOT NULL
);

-- Agents tied to a tenant
CREATE TABLE agent (
  id         SERIAL PRIMARY KEY,
  tenant_id  INTEGER NOT NULL REFERENCES tenant(id),
  name       TEXT NOT NULL,
  role       TEXT NOT NULL,
  authority  TEXT NOT NULL
);

-- Enable RLS
ALTER TABLE agent ENABLE ROW LEVEL SECURITY;

CREATE POLICY tenant_isolation_policy
ON agent
USING (tenant_id = current_setting('app.current_tenant')::INTEGER);

-- View for UI
CREATE VIEW agents_view AS
SELECT a.id,
       a.name,
       a.role,
       a.authority,
       t.name AS tenant_name
FROM agent a
JOIN tenant t ON t.id = a.tenant_id;
```

