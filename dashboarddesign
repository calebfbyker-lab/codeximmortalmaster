## 4. Kubernetes deployment and scaling

These configs define deployments and services for the dashboard, API gateway, and agent server, plus an HPA for autoscaling [7][8].

```yaml
# k8s/api-gateway-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: codeximmortal-api-gateway
spec:
  replicas: 2
  selector:
    matchLabels:
      app: codeximmortal-api-gateway
  template:
    metadata:
      labels:
        app: codeximmortal-api-gateway
    spec:
      containers:
        - name: api-gateway
          image: codeximmortal/api-gateway:latest
          ports:
            - containerPort: 8080
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: codeximmortal-db-secret
                  key: url
          resources:
            requests:
              cpu: "100m"
              memory: "256Mi"
            limits:
              cpu: "500m"
              memory: "512Mi"
---
apiVersion: v1
kind: Service
metadata:
  name: codeximmortal-api-gateway
spec:
  type: ClusterIP
  selector:
    app: codeximmortal-api-gateway
  ports:
    - port: 80
      targetPort: 8080
```

