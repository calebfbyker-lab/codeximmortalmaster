## 2. API gateway with OAuth2 and RLS

These snippets show a Node/Express gateway that attaches tenant context for PostgreSQL RLS as recommended in multi-tenant patterns [1][2][3][4].

```ts
// server/index.ts
import express from 'express';
import session from 'express-session';
import { authMiddleware } from './middleware/auth';
import { attachTenantContext } from './middleware/tenant';
import { agentRouter } from './routes/agents';
import { taskRouter } from './routes/tasks';
import { platformRouter } from './routes/platform';

const app = express();
app.use(express.json());
app.use(
  session({
    secret: 'codeximmortal',
    resave: false,
    saveUninitialized: false,
  })
);

// OAuth2 is assumed to populate req.session.user and scopes
app.use('/api', authMiddleware, attachTenantContext);
app.use('/api/agents', agentRouter);
app.use('/api/tasks', taskRouter);
app.use('/api/platform', platformRouter);

app.listen(8080, () => {
  console.log('CodexImmortal API gateway listening on :8080');
});
```

```ts
// server/middleware/auth.ts
import { Request, Response, NextFunction } from 'express';

export async function authMiddleware(
  req: Request,
  res: Response,
  next: NextFunction
) {
  if (!req.session.user) {
    return res.status(401).json({ error: 'unauthenticated' });
  }
  // Additional scope checks could go here
  next();
}
```

```ts
// server/middleware/tenant.ts
import { Request, Response, NextFunction } from 'express';
import { pool } from '../pg';

export async function attachTenantContext(
  req: Request,
  res: Response,
  next: NextFunction
) {
  const tenantId = req.session.user?.tenantId;
  if (!tenantId) {
    return res.status(400).json({ error: 'tenant context missing' });
  }
  // Set the PostgreSQL config parameter used by RLS policies
  await pool.query('SET app.current_tenant = $1', [tenantId]);
  next();
}
```

```ts
// server/pg.ts
import { Pool } from 'pg';

export const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
});
```

```ts
// server/routes/agents.ts
import { Router } from 'express';
import { pool } from '../pg';

export const agentRouter = Router();

agentRouter.get('/', async (_req, res) => {
  const { rows } = await pool.query(
    'SELECT id, name, role, authority, tenant_name FROM agents_view'
  );
  res.json(rows);
});
```

Task and platform routes follow the same pattern, querying RLS-protected tables or views.

