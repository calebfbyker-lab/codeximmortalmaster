# [CODEX-TAG: CALEB-FEDOR-BYKER-KONEV-10271998-CODEXIMMORTAL]
from dataclasses import dataclass, asdict, field
from typing import Dict, Any, List
import hashlib
import hmac
import json
import time


def _canon(x: Any) -> bytes:
    return json.dumps(x, sort_keys=True, separators=(",", ":"), default=str).encode()


def stable_hash(x: Any) -> str:
    return hashlib.sha256(_canon(x)).hexdigest()


class DevVerifier:
    algorithm = "DEV-HMAC-SHA256-REPLACE-WITH-ML-DSA"

    def __init__(self, key: bytes = b"development-only"):
        self.key = key

    def sign(self, payload: Dict[str, Any]) -> str:
        return hmac.new(self.key, _canon(payload), hashlib.sha256).hexdigest()

    def verify(self, payload: Dict[str, Any], sig: str) -> bool:
        return hmac.compare_digest(self.sign(payload), sig)


@dataclass
class PredicateProof:
    predicate: str
    result: bool
    agent_id: str
    evidence: Dict[str, Any]
    issued_at: int = field(default_factory=lambda: int(time.time()))
    signature: str = ""
    algorithm: str = ""

    def body(self):
        return {
            "predicate": self.predicate,
            "result": self.result,
            "agent_id": self.agent_id,
            "evidence": self.evidence,
            "issued_at": self.issued_at,
        }


class GoalProof:
    def __init__(self, verifier: DevVerifier | None = None):
        self.verifier = verifier or DevVerifier()
        self.proofs: List[PredicateProof] = []

    def add(self, proof: PredicateProof):
        proof.algorithm = self.verifier.algorithm
        proof.signature = self.verifier.sign(proof.body())
        self.proofs.append(proof)

    def verify(self, predicates: List[str]) -> Dict[str, Any]:
        seen = {}
        for proof in self.proofs:
            valid = proof.result and self.verifier.verify(proof.body(), proof.signature)
            seen.setdefault(proof.predicate, []).append(valid)

        truth_vector = [any(seen.get(predicate, [False])) for predicate in predicates]
        complete = bool(predicates) and all(truth_vector)

        return {
            "complete": complete,
            "mathematical_proof": f"AND({','.join(map(str, truth_vector))})={complete}",
            "cryptographic_proof": stable_hash([asdict(proof) for proof in self.proofs]),
            "proof_count": len(self.proofs),
        }
