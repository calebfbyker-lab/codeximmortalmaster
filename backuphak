from dataclasses import dataclass, asdict, field
from typing import Dict, Any, List
import hashlib
import json
import time


@dataclass
class EvidenceRecord:
    task_id: str
    source: str
    payload: Dict[str, Any]
    created_at: float = field(default_factory=time.time)

    def digest(self) -> str:
        return hashlib.sha256(
            json.dumps(asdict(self), sort_keys=True, default=str).encode()
        ).hexdigest()


class EvidenceStore:
    def __init__(self):
        self.records: List[EvidenceRecord] = []

    def add(self, record: EvidenceRecord):
        self.records.append(record)

    def merkle_like_root(self) -> str:
        hashes = sorted(r.digest() for r in self.records)
        return hashlib.sha256("".join(hashes).encode()).hexdigest() if hashes else hashlib.sha256(b"").hexdigest()
