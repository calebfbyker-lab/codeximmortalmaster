# [CODEX-TAG: CALEB-FEDOR-BYKER-KONEV-10271998-CODEXIMMORTAL]
from collections import deque
from typing import Optional
from .models import Task, OODAResult, SovereignEvent, FirmwareProfile, Agent
from .policies import require_human_gate
from .evidence import EvidenceStore, EvidenceRecord
from .sandbox import PassiveSandbox
from .proofs import GoalProof, PredicateProof
from .factory import create_agent
from .prompting import render_prompt
from .lineage import LineageRecord


class AgenticHacker:
    def __init__(self, max_agents: int = 8, max_depth: int = 3):
        self.evidence = EvidenceStore()
        self.sandbox = PassiveSandbox()
        self.max_agents = max_agents
        self.max_depth = max_depth
        self.lineage = []

    def _spawn_children(self, parent: Agent, depth: int):
        if depth >= self.max_depth:
            return []

        children = []
        for i in range(parent.max_children):
            child_id = f"{parent.agent_id}.sub{i+1}.d{depth+1}"
            child = create_agent(
                child_id,
                "ANALYST",
                max_children=max(parent.max_children - 1, 0),
            )
            children.append(child)
            self.lineage.append(
                LineageRecord(parent.agent_id, child_id, "predicate-verification")
            )
        return children

    def run(self, task: Task, firmware: Optional[FirmwareProfile] = None) -> OODAResult:
        observe = {
            "task": task.__dict__,
            "firmware": self.sandbox.inspect_firmware(firmware) if firmware else None,
        }

        human_gate = require_human_gate(task)
        orient = {
            "risk_score": task.risk_score,
            "human_gate_required": human_gate,
            "max_agents": self.max_agents,
            "max_depth": self.max_depth,
        }

        if human_gate:
            decision = "HUMAN_GATE"
            act = {"decision": decision, "executed": False, "reason": "policy_gate"}
            self.evidence.add(
                EvidenceRecord(
                    task.task_id,
                    "core.run",
                    {"observe": observe, "orient": orient, "act": act},
                )
            )
            learn = {
                "event": SovereignEvent(
                    "TASK_RUN", {"task_id": task.task_id, "decision": decision}
                ).content_hash,
                "evidence_root": self.evidence.merkle_like_root(),
                "proof": None,
            }
            return OODAResult(observe, orient, {"decision": decision}, act, learn)

        root = create_agent("STRATEGIST-PRIME", "STRATEGIST", max_children=2)
        queue = deque((root, 0, predicate) for predicate in task.predicates)
        used = [root.agent_id]
        goal_proof = GoalProof()

        while queue and len(set(used)) < self.max_agents:
            agent, depth, predicate = queue.popleft()
            prompt = render_prompt(agent, task)
            evidence = {
                "prompt": prompt,
                "target": task.target,
                "predicate": predicate,
                "depth": depth,
            }

            goal_proof.add(
                PredicateProof(
                    predicate=predicate,
                    result=True,
                    agent_id=agent.agent_id,
                    evidence=evidence,
                )
            )
            self.evidence.add(EvidenceRecord(task.task_id, agent.agent_id, evidence))

            if depth < self.max_depth:
                for child in self._spawn_children(agent, depth):
                    if len(set(used)) >= self.max_agents:
                        break
                    used.append(child.agent_id)
                    queue.append((child, depth + 1, predicate))

        proof = goal_proof.verify(task.predicates)
        decision = "COMPLETE" if proof["complete"] else "INCOMPLETE"
        act = {
            "decision": decision,
            "executed": proof["complete"],
            "agents_used": len(set(used)),
        }
        learn = {
            "event": SovereignEvent(
                "TASK_RUN", {"task_id": task.task_id, "decision": decision}
            ).content_hash,
            "evidence_root": self.evidence.merkle_like_root(),
            "proof": proof,
            "lineage_hashes": [record.lineage_hash() for record in self.lineage],
        }

        return OODAResult(observe, orient, {"decision": decision}, act, learn)
```

